<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@android:drawable/ic_dialog_alert"
        app:tint="?attr/colorError" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="🚨 EMERGENCY ALERT SENT"
        android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
        android:textColor="?attr/colorError"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStatusMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Emergency contacts have been notified with your location and evidence."
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp" />

    <TextView
        android:id="@+id/tvLocationDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Location: Fetching..."
        android:textAppearance="@style/TextAppearance.Material3.BodySmall" />

    <TextView
        android:id="@+id/tvDriveLink"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="📹 Evidence: Pending Upload"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="?attr/colorPrimary" />

</LinearLayout>
