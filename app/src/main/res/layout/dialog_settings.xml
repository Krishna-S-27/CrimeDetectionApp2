<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#1F1F1F">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Backend Settings"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Base URL (including http:// and port)"
        android:textColor="#BBBBBB"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

    <EditText
        android:id="@+id/editServerUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="http://192.168.1.10:5000/"
        android:inputType="textUri"
        android:textColor="#FFFFFF"
        android:textColorHint="#666666"
        android:layout_marginTop="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ensure your phone and server are on the same Wi-Fi network."
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginTop="12dp" />

</LinearLayout>